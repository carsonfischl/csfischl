Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: http://localhost:8000/src/editor/svgedit.css

@charset "utf-8";

:root { --main-bg-color: #72797A; --text-color: #000000; --border-color: #8=
08080; --canvas-bg-color: #B2B2B2; --link-color: #19c; --ruler-color: #B2B2=
B2; --icon-bg-color: #72797A; --icon-bg-color-hover: #2B3C45; --input-color=
: #B2B2B2; --orange-color: #f9bc01; --global-se-spin-input-width: 82px; }

.svg_editor * { transform-origin: 0px 0px; }

.svg_editor { display: grid; grid-template: "main main main top top" "left =
corner rulerX rulerX side" 15px "left rulerY workarea workarea side" 1fr "l=
eft bottom bottom bottom bottom" 40px / 40px 15px 50px 1fr 15px; font-size:=
 8pt; background: var(--main-bg-color); font-family: Verdana, Helvetica, Ar=
ial; color: var(--text-color); user-select: text; width: 100%; height: 100%=
; }

#title_panel > p { color: white; padding-left: 5px; padding-right: 3px; fon=
t-weight: bold; }

@media screen and (max-width: 1250px) {
  .svg_editor { grid-template-rows: minmax(80px, auto) 15px 1fr 40px; }
}

.svg_editor.open { grid-template-columns: 34px 15px 50px 1fr 220px; }

#svgroot { user-select: none; position: absolute; top: 0px; left: 0px; }

#workarea { grid-area: workarea; background-color: rgb(160, 160, 160); bord=
er: 1px solid var(--border-color); overflow: auto; text-align: center; }

#svgcanvas { line-height: normal; display: inline-block; background: var(--=
canvas-bg-color); text-align: center; vertical-align: middle; position: rel=
ative; }

#sidepanels { grid-area: side; }

#sidepanel_handle { writing-mode: vertical-rl; text-orientation: upright; c=
olor: white; position: absolute; cursor: pointer; top: 50%; }

.svg_editor:not(.open) #sidepanel_content { display: none; }

a { color: var(--link-color); }

hr { border-top: none; border-right: none; border-left: none; border-image:=
 initial; border-bottom: 1px solid var(--border-color); }

#linkLabel > svg { height: 20px; padding-top: 4px; }

#layersLabel { color: white; }

#layerpanel { user-select: none; padding-left: 15px; }

#layerbuttons { margin: 0px; padding: 0px 2px; width: 125px; height: 20px; =
border: 0px; overflow: hidden; display: flex; justify-content: center; alig=
n-items: center; }

#layerlist { margin: 1px; padding: 0px; width: 132px; border-collapse: coll=
apse; border: 1px solid var(--border-color); background-color: rgb(255, 255=
, 255); }

#layerlist tr.layer { background-color: rgb(255, 255, 255); margin: 0px; pa=
dding: 0px; }

#layerlist tr.layersel { border: 1px solid var(--border-color); background-=
color: rgb(204, 204, 204); }

#layerlist td.layervis { width: 22px; cursor: pointer; }

#layerlist td.layerinvis { background-image: none; cursor: pointer; }

#layerlist td.layervis * { display: block; }

#layerlist td.layerinvis * { display: none; }

#layerlist td.layername { cursor: pointer; }

#layerlist td.layername:hover { color: blue; }

#layerlist tr.layersel td.layername { font-weight: bold; }

#selLayerLabel { white-space: nowrap; }

#selLayerNames { display: block; top: -8px; position: relative; }

#main_button { grid-area: main; color: rgb(255, 255, 255); border-radius: 3=
px; padding-block: 2px; padding-left: 3px; height: 34px; }

#main_icon { position: relative; top: -2px; left: -2px; width: 95px; line-h=
eight: 26px; }

#main_icon:hover { background: rgb(238, 238, 238) !important; }

#main_icon.buttondown { border-radius: 3px 3px 0px 0px; background: rgb(238=
, 238, 238) !important; box-shadow: none !important; }

#logo { margin-top: -2px; }

#logo img { border: 0px; width: 28px; height: 28px; }

#main_icon > div { float: left; }

#main_button .dropdown { position: absolute; right: 7px; top: 4px; }

#main_icon span { position: absolute; inset: 0px; display: block; z-index: =
2; font-weight: bold; padding-left: 34px; line-height: 32px; font-family: s=
ans-serif; }

#main_menu { z-index: 12; background: rgb(238, 238, 238); position: relativ=
e; width: 230px; padding: 5px; box-shadow: rgb(85, 85, 85) 1px 1px 4px; fon=
t-size: 1.1em; display: none; overflow: hidden; clear: both; top: -9px; }

#main_menu ul, #main_menu li { list-style: none; margin: 0px; padding: 0px;=
 }

#main_menu li { line-height: 22px; padding-top: 7px; padding-left: 7px; mar=
gin: -5px; overflow: auto; cursor: pointer; }

#main_menu li:hover { background: rgb(255, 255, 204); }

#main_menu li > div { float: left; padding-right: 5px; }

#main_menu p { margin-top: 5px; }

#tools_top { grid-area: top; display: flex; flex-flow: wrap; align-items: f=
lex-start; background-color: var(--main-bg-color); }

#tools_top > * { display: flex; flex-flow: wrap; background-color: var(--ma=
in-bg-color); }

#tools_bottom { grid-area: bottom; overflow: auto hidden; display: flex; al=
ign-items: center; scrollbar-width: thin; }

#tools_bottom::-webkit-scrollbar { width: 3px; height: 3px; }

#tools_bottom se-list, #tools_bottom se-select { margin-bottom: 8px; }

#zoom { color: var(--text-color); background-color: var(--main-bg-color); b=
order: none; }

#tools_left { grid-area: left; border-right: none; margin-left: auto; margi=
n-right: auto; overflow-y: scroll; scrollbar-width: none; user-select: none=
; }

#tools_left::-webkit-scrollbar { width: 3px; }

#tools_left::-webkit-scrollbar-track, #tools_bottom::-webkit-scrollbar-trac=
